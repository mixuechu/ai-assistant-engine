# AI Assistant Engine Configuration

# LLM Provider: claude | claude-vertex | openai | deepseek
AI_LLM_PROVIDER=claude-vertex

# Claude via Vertex AI (uses Google Cloud ADC — no API key needed)
# These are auto-detected from gcloud env if not set:
# AI_VERTEX_PROJECT_ID=your-gcp-project
# AI_VERTEX_REGION=us-east5
AI_CLAUDE_MODEL=claude-sonnet-4-6

# Claude via Anthropic API (alternative to Vertex)
# AI_LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI (optional)
# AI_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxx
# AI_OPENAI_MODEL=gpt-4o

# DeepSeek (optional)
# AI_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-xxxxx
# AI_DEEPSEEK_MODEL=deepseek-chat

# Engine Database (for sessions/messages)
AI_DATABASE_URL=sqlite+aiosqlite:///./ai_assistant.db

# Host system JWT secret (must match host app)
AI_JWT_SECRET=your-host-app-secret-key
AI_JWT_ALGORITHM=HS256

# CORS (comma-separated origins)
AI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Debug mode
AI_DEBUG=true
