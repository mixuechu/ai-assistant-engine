# AI Assistant Engine Configuration

# LLM Provider (claude, openai, deepseek)
AI_LLM_PROVIDER=claude

# Claude / Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx
AI_CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI (optional)
OPENAI_API_KEY=sk-xxxxx
AI_OPENAI_MODEL=gpt-4o

# DeepSeek (optional)
DEEPSEEK_API_KEY=sk-xxxxx
AI_DEEPSEEK_MODEL=deepseek-chat

# Engine Database (for sessions/messages)
AI_DATABASE_URL=sqlite+aiosqlite:///./ai_assistant.db

# Host system JWT secret (must match host app)
AI_JWT_SECRET=your-host-app-secret-key
AI_JWT_ALGORITHM=HS256

# CORS (comma-separated origins)
AI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Debug mode
AI_DEBUG=true
